		fi
		echo -e "\n${GREEN} Closing TMUX session.${RESET}\n Do this command in order to filter open ports:\ngrep \"open\" <nc_open_ports> file."
		tmux kill-session -t "$SESSION"
	else
		echo -e "${RED} Error: failed to compress complete nc scans results.${RESET}"
	fi
fi

