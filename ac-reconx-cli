echo -e "\n${ALT}${YELLOW_BOLD}  N.B.: ${UL}Netcat scans will likely finish after Nmap scans, you'll probably hear your PC suffer in background.${RESET}\n        ${YELLOW_BOLD} ${UL}Do not panic!${RESET}"

echo -e "${WHITE_BOLD}\n=============================================\n[+] Netcat scans are running on all available targets."
echo -e "=============================================${RESET}\n"



# doing nmap scan searching for open ports
while IFS= read -r t;do
	[[ -z "$t" ]] && continue
	target_dir="./${t//./_}"
	echo -e "${SCAN_ON} ${YELLOW}[i] Searching for open ports over 65535 available ports on target $t :${RESET}"
	nmap --open -Pn -n -vv -p- -T4 -oN "$target_dir/NMAP/open_ports" "$t"
	echo -e "${GREEN}\n[!] Target $t COMPLETED\n\n##########################################${RESET}\n\n"
done < "./alive_targets.txt"

echo -e "${WHITE_BOLD}\n=============================================\n[+] Open ports file created for every target that is alive."
echo -e "=============================================${RESET}\n"


# listing tree
tree "$PWD"

# creating port list for nmap ServiceVersionScan and NSE Scan
echo -e "\n${BU}${YELLOW}[i] Creating file with the open ports for each target inside its directory, called 'ports_list_4_nmap.txt'.${RESET}"
while IFS= read -r t;do
	[[ -z "$t" ]] && continue
	target_dir="./${t//./_}"
	open_ports_file="$target_dir/NMAP/open_ports"
	if [[ -s "$open_ports_file" ]];then
		grep "^[0-9]" "$target_dir/NMAP/open_ports" | cut -d '/' -f1 | sed ':a;N;$!ba;s/\n/,/g' > "$target_dir/NMAP/ports_list_4_nmap"
	else
		echo -e "${YELLOW_BOLD}[!] Open port file do non exist or is empty.${RESET}"
	fi
done < "./alive_targets.txt"

echo -e "\n${WHITE_BOLD}=============================================\n[+] Ports list files created for every target."
echo -e "=============================================${RESET}\n"


# list tree
tree "$PWD"


# nmap service version scan and NSE script scan on open ports
echo -e "\n${YELLOW}[i] Running nmap scan to detect service version(aka fingerprint) and executing NSE default scripts on them:${RESET}"

while IFS= read -r t;do
	[[ -z "$t" ]] && continue
	target_dir="./${t//./_}"
	ports_file="$target_dir/NMAP/ports_list_4_nmap"
	if [[ -s "$ports_file" ]];then
		echo -e "\n${SCAN_ON} ${YELLOW}[i] Scanning target $t :${RESET}"
		nmap -Pn -n -p "$(cat "$ports_file")" -vv -sVC -oA "$target_dir/NMAP/nmap_VScan_NSEScan" "$t"
		echo -e "${GL}${GREEN}[!] Scan COMPLETED over target $t\n##########################################\n${RESET}"
		sleep 3
	else
		echo -e "\n${YELLOW_BOLD}[!] Target $t doesn't expose open ports to scan.${RESET}"
		sleep 3
	fi
done < "./alive_targets.txt"
echo -e "\n${WHITE_BOLD}=============================================\n[+] Nmap version scan and script scan COMPLETED for every target that is alive and has open ports."
echo -e "=============================================${RESET}\n"


