function nc_command() {
	t="$1"
	target_dir="./${t//./_}/NMAP"
	echo -e "${SCAN_ON} ${YELLOW}[i] Scanning 65535 ports for open ones on target $t :${RESET}"
	for p in $(seq 1 65535);do
		echo "Testing port: $p" | tee -a "$target_dir/nc_open_ports" && timeout 0.5 nc -nvz "$t" "$p" 2>&1 | grep open | tee -a "$target_dir/nc_open_ports"
	done
        echo -e "${GREEN}\n[!] Netcat scan COMPLETED on target '$t'.\n##########################################${RESET}\n\n"
}

# netcat scan marker check before closing scanner, if no zip flag is used then no need to check. The nc_open_ports files will be updated until the netcat
## scanner process are alive
function nc_marker_check () {
	echo -e "\n${ALT}${YELLOW_BOLD} Almost there! Waiting nc scans to be completed(necessary to create a COMPLETE zip file).${RESET}"
	scan_completed=0
	ct=0
	while IFS= read -r _;do
		ct=$((ct+1))
	done < "./alive_targets.txt"

	total_targets="$ct"
	echo -e "Netcat scan status: [ $scan_completed / $total_targets]"

	while IFS= read -r t;do
		nc_m="./${t//./_}/NMAP/.nc_completed"
		while [[ ! -f "$nc_m" ]];do
			sleep 1
		done
		scan_completed=$((scan_completed+1))
		echo -e "\n${GREEN} nc scan for target \"$t\" completed.${RESET}"
		echo -e "Netcat scan status: [ $scan_completed / $total_targets]"
	done < "$1"
}

