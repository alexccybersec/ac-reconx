RESULTS_LOCATION="$HOME/ac-reconx-safe/$(basename "$PWD")"
ZIP_PART_FN="ac-reconx_$(basename "$PWD")_partial_$(date +%d-%B-%Y)"
ZIP_COMP_FN="ac-reconx_$(basename "$PWD")_complete_$(date +%d-%B-%Y)"
if [[ -n "$ZIP_FILE" && "$ZIP_FILE" == "true" ]];then
	compressionToZip "$ZIP_PART_FN" "$RESULTS_LOCATION"
	if nc_marker_check "./alive_targets.txt";then
		if compressionToZip "$ZIP_COMP_FN" "$RESULTS_LOCATION";then
