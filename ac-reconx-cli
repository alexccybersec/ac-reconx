	tmux new-window -d -t "$SESSION" -n "$t" "bash -c 'nc_command \"$t\"; touch \"$nc_marker\";exec bash'" && sleep 2 || echo -e "\n${ALERT}${RED}[-] Failed to execute netcat scan for target '$t'.${RESET}\n"
done < "./alive_targets.txt"

echo -e "${BOOK}${GREEN}[i] Use this command to attach on current Tmux session:${RESET}"
echo -e "qterminal -w $PWD -e bash -c 'tmux attach-session -t $SESSION' 2>/dev/null\n"
echo -e "${BOOK}${YELLOW_BOLD} Inside tmux session, use:${RESET}"
echo -e "${YELLOW}\t Press \"Ctrl+b\" and then \"w\" to list and select the target you want.${RESET}"
echo -e "${YELLOW}\t Press \"Ctrl+b\" and then \"d\" to detach from tmux client.${RESET}"
echo -e "\n${YELLOW_BOLD}   When netcat scans are finished, use this command to kill the client session:${RESET}"
echo -e "\t${YELLOW} tmux ls | grep $SESSION ${RESET}\t# list tmux ac-recox active session;"
