# check for parameters reuse
function check_flag_reuse(){
	if [[ "$1" -gt 0 ]];then
		echo -e "\n${ALERT}${RED} Error: flag reuse not allowed.\n${RESET}"
		usage
		exit 1
	fi
}

# check on corporation name sintax, if correct create a relative directory inside $HOME directory using the corporation name
function client_dir_name_check(){
        if [[ "$1" =~ [^[:alnum:]_-] ]];then
                echo -e "\n${ALERT}${RED}[!] Corporation name contain one or more prohibited characters.${RESET}"
                echo -e "${YELLOW}  [i] Characters accepted:${RESET} numbers, letters or special chars - or _ \n"
                echo -e "${BYE}${YELLOW}[i] Exiting, to prevent unpredictable script behaviour.${RESET}"
                exit 0
        else
                cn="${1,,}"
                echo -e "\n${GL}${GREEN}[+] Corporation name \"$cn\" syntax accepted!${RESET}\n"
        fi

}

# check on target list IPs syntax
function ip_list_check() {
        OCTET="((25[0-5])|(2[0-4][0-9])|(1[0-9][0-9])|([1-9]?[0-9]))"
        IP_FILTER="^$OCTET\.$OCTET\.$OCTET\.$OCTET$"
        targets_file="$1"
        if [[ -e "$targets_file" ]];then
                echo -e "\n${QM}${YELLOW}Checking IPs syntax:${RESET}"
		while IFS= read -r t;do
                        if [[ "$t" =~ $IP_FILTER ]];then
                                echo -e "${GL}${GREEN}target \"$t\" passed the syntax check${RESET}"
                                sleep 1
                        elif [[ -z "$t" ]];then
                                continue
                        else
                                echo -e "\n${ALERT}${RED}target \"$t\" didn't pass the syntax check. Correct it to continue. ${RESET}"
                                echo -e "\n${BYE}[i] Exiting, to prevent unpredictable script behaviour.\n"
                                exit 1
                        fi
                done < "$targets_file"
        else
                echo -e "\n${ALERT}${RED}[!] There is no such file inside your current working dir '$PWD' .\n  Create a file with IP list, one target x line and then try again.${RESET}\n"
                echo -e "${BYE}${YELLOW} Bye!${RESET}"
                exit 1
        fi
}

# clean up if requirements are not satisfied
function clean_up () {
	DIR_OUT="$HOME/ac-reconx-safe/$cn_lowercase"
	if [[ -d "$DIR_OUT" ]];then
		if rm -r "$DIR_OUT";then
			echo -e "\n${CU}${YELLOW} Removing \"$cn_lowercase\" corporation directory from dir \"$HOME/ac-reconx-safe\"${RESET}"
		else
			echo -e "\n${ALERT}${RED} Error: failed to remove \"$cn_lowercase\" corporation directory from dir \"$HOME/ac-reconx-safe\"${RESET}"
		fi
	else
		echo -e "\n${ALERT}${RED} Error: \"$cn_lowercase\" corporation directory does not exist in \"$HOME/ac-reconx-safe\"${RESET}"
	fi
}


# tools check
## nc, tmux, nmap, zip
function tool_check () {
	# check if tool are installed and if not ask for sudo permissions to download them from the APT repository
	if command -v tmux >/dev/null && command -v nc >/dev/null && command -v nmap >/dev/null && command -v zip > /dev/null;then
		echo -e "\n${G_B}==============================================\n${OK}[i] Tools requirements satisfied!\n==============================================${RESET}\n"
        else
		echo -e "${ALT}${YELLOW_BOLD} One or more tools are missing. Need sudo privileges to install them.${RESET}"
		while true;do
			echo -e -n "\n${YELLOW_BOLD} Do you want to proceed? (y/n) ${RESET}"
			read -r -p "" SP
			if [[ ! "$SP" =~ ^(y|yes|n|no)$ ]];then
				echo -e "\n${YELLOW} Please provide a valid answer.${RESET}"
			else
				break
			fi
		done
		if [[ ! "${SP,,}" =~ ^(y|yes)$ ]];then
			clean_up
			exit 0
		fi

		if ! sudo -v;then
			echo -e "\n${ERROR}${RED} Failed to authenticate with sudo.${RESET}"
			clean_up
			exit 1
		fi

		# check each tool is installed and eventually install it to continue
		tools=("nc" "nmap" "tmux" "zip")
		for tool in "${tools[@]}";do
			if ! command -v "$tool" >/dev/null;then
				if [[ "$tool" == "nc" ]];then
					tool="netcat-openbsd"
				fi

				echo -e "\n${YELLOW}[!] \"$tool\" tool not installed. Install it to continue.${RESET}"
		                while true;do
		                        read -r -p "[?] Install $tool (y/n) ? " R1
		                        if [[ ! "${R1,,}" =~ ^(y|yes|n|no)$ ]];then
						echo -e "\n${YELLOW} Please provide a valid answer.\n${RESET}"
					else
						break
					fi
				done

				if [[ "${R1,,}" =~ ^(y|yes)$ ]];then
					if ! sudo apt install "$tool" -y >/dev/null 2>&1;then
						echo -e "\n${ERROR}${RED} Failed to install \"$tool\" .${RESET}"
						clean_up
						exit 1
					else
						echo -e "\n${BU}${GREEN} \"$tool\" successfully installed!${RESET}"
					fi
				else
		                	echo -e "\n${BYE}${YELLOW}Tool requirements not satisfied.${RESET}"
					clean_up
					exit 1
				fi
			fi
		done
	fi

}


